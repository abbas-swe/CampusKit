---
interface Props {
  id?: string;
  badge?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { id, badge, title, subtitle, align = 'left', class: className = '' } = Astro.props;

const alignmentClasses = {
  left: 'text-left items-start',
  center: 'text-center items-center mx-auto',
};
---

<section id={id} class={`py-12 sm:py-16 ${className}`}>
  <div class={`flex flex-col mb-8 sm:mb-12 max-w-3xl ${alignmentClasses[align]}`}>
    {
      badge && (
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-academic-50 text-academic-700 border border-academic-200 mb-3">
          {badge}
        </span>
      )
    }
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 leading-tight">
      {title}
    </h2>
    {
      subtitle && (
        <p class="mt-3 text-base sm:text-lg text-slate-600 leading-relaxed">
          {subtitle}
        </p>
      )
    }
  </div>
  <slot />
</section>
