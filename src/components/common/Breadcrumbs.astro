---
import type { BreadcrumbItem } from '../../types/seo';

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<nav aria-label="Breadcrumb" class={`py-3 text-sm text-slate-500 ${className}`}>
  <ol class="flex items-center flex-wrap gap-1.5 list-none p-0 m-0">
    <li class="flex items-center">
      <a href="/" class="hover:text-academic-700 transition-colors flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span>Home</span>
      </a>
    </li>

    {
      items.map((crumb, idx) => {
        const isLast = idx === items.length - 1;
        return (
          <li class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-slate-300 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
            </svg>
            {isLast ? (
              <span class="font-medium text-slate-900 truncate" aria-current="page">
                {crumb.name}
              </span>
            ) : (
              <a href={crumb.item} class="hover:text-academic-700 transition-colors">
                {crumb.name}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
