---
import Container from '../common/Container.astro';
import Section from '../common/Section.astro';
import ToolCard from '../tools/ToolCard.astro';
import { CATEGORIES } from '../../data/categories';
import { getToolsByCategory } from '../../data/tools';
---

<div class="bg-white py-4 border-y border-slate-200/80">
  <Container size="xl">
    <Section
      badge="Catalog Directory"
      title="Browse by Category"
      subtitle="Explore specialized tools designed for academic calculations, workload planning, and study focus."
    >
      <div class="space-y-16">
        {
          CATEGORIES.map((cat) => {
            const categoryTools = getToolsByCategory(cat.id).filter((t) => t.status === 'active');
            if (categoryTools.length === 0) return null;
            return (
              <div id={cat.id} class="scroll-mt-24">
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pb-4 mb-6 border-b border-slate-200">
                  <div>
                    <div class="flex items-center gap-2">
                      <h3 class="text-xl sm:text-2xl font-bold text-slate-900">{cat.name}</h3>
                      <span class={`text-xs font-semibold px-2 py-0.5 rounded-full border ${cat.colorClass}`}>
                        {cat.badge}
                      </span>
                    </div>
                    <p class="text-sm text-slate-600 mt-1 max-w-2xl">{cat.description}</p>
                  </div>
                  <span class="text-xs font-medium text-slate-400">
                    {categoryTools.length} {categoryTools.length === 1 ? 'tool' : 'tools'}
                  </span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                  {categoryTools.map((tool) => (
                    <ToolCard tool={tool} />
                  ))}
                </div>
              </div>
            );
          })
        }
      </div>
    </Section>
  </Container>
</div>
