---
interface Props {
  id: string;
  label: string;
  name?: string;
  type?: 'text' | 'number' | 'email' | 'search';
  value?: string | number;
  placeholder?: string;
  helperText?: string;
  error?: string;
  required?: boolean;
  min?: number;
  max?: number;
  step?: number | string;
  prefix?: string;
  suffix?: string;
  class?: string;
  inputClass?: string;
}

const {
  id,
  label,
  name = id,
  type = 'text',
  value,
  placeholder,
  helperText,
  error,
  required = false,
  min,
  max,
  step,
  prefix,
  suffix,
  class: className = '',
  inputClass = '',
} = Astro.props;
---

<div class={`flex flex-col gap-1.5 ${className}`}>
  <div class="flex items-center justify-between">
    <label for={id} class="text-xs font-semibold text-slate-700">
      {label}
      {required && <span class="text-rose-500 ml-0.5" aria-hidden="true">*</span>}
    </label>
    {error && <span class="text-xs font-medium text-rose-600" id={`${id}-error`}>{error}</span>}
  </div>

  <div class="relative flex items-center rounded-lg shadow-subtle">
    {
      prefix && (
        <span class="inline-flex items-center px-3 py-2 text-sm text-slate-500 bg-slate-50 border border-r-0 border-slate-300 rounded-l-lg select-none">
          {prefix}
        </span>
      )
    }
    <input
      id={id}
      name={name}
      type={type}
      value={value}
      placeholder={placeholder}
      required={required}
      min={min}
      max={max}
      step={step}
      aria-describedby={error ? `${id}-error` : helperText ? `${id}-helper` : undefined}
      aria-invalid={error ? 'true' : 'false'}
      class={`w-full px-3 py-2 text-sm text-slate-900 bg-white border border-slate-300 ${
        prefix ? 'rounded-l-none' : 'rounded-l-lg'
      } ${suffix ? 'rounded-r-none' : 'rounded-r-lg'} focus:outline-none focus:ring-2 focus:ring-academic-600 focus:border-transparent transition-all disabled:bg-slate-100 disabled:cursor-not-allowed ${
        error ? 'border-rose-400 focus:ring-rose-500' : ''
      } ${inputClass}`}
    />
    {
      suffix && (
        <span class="inline-flex items-center px-3 py-2 text-sm text-slate-500 bg-slate-50 border border-l-0 border-slate-300 rounded-r-lg select-none">
          {suffix}
        </span>
      )
    }
  </div>

  {
    helperText && !error && (
      <p class="text-xs text-slate-500" id={`${id}-helper`}>
        {helperText}
      </p>
    )
  }
</div>
