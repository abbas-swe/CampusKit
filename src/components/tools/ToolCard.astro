---
import type { ToolMetadata } from '../../types/tools';

interface Props {
  tool: ToolMetadata;
  class?: string;
}

const { tool, class: className = '' } = Astro.props;

const categoryColors = {
  academic: 'text-blue-700 bg-blue-50 border-blue-200/60',
  productivity: 'text-indigo-700 bg-indigo-50 border-indigo-200/60',
  ai: 'text-purple-700 bg-purple-50 border-purple-200/60',
};

const badgeColors: Record<string, string> = {
  Popular: 'bg-amber-50 text-amber-800 border-amber-200',
  'High Intent': 'bg-emerald-50 text-emerald-800 border-emerald-200',
  'Student Favorite': 'bg-blue-50 text-blue-800 border-blue-200',
  Core: 'bg-slate-100 text-slate-800 border-slate-200',
};
---

<a
  href={`/tools/${tool.slug}`}
  class={`group relative flex flex-col p-6 bg-white rounded-xl border border-slate-200/80 shadow-subtle hover:shadow-card hover:border-academic-300 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-academic-600 ${className}`}
  data-tool-card
  data-category={tool.category}
  data-title={tool.name.toLowerCase()}
  data-description={tool.description.toLowerCase()}
>
  <div class="flex items-start justify-between gap-3 mb-4">
    <!-- Icon Container -->
    <div class="w-11 h-11 rounded-lg bg-academic-50 text-academic-700 border border-academic-100 flex items-center justify-center group-hover:bg-academic-700 group-hover:text-white transition-colors duration-200">
      {
        tool.iconName === 'calculator' && (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
        )
      }
      {
        tool.iconName === 'chart' && (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" />
          </svg>
        )
      }
      {
        tool.iconName === 'target' && (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        )
      }
      {
        tool.iconName === 'award' && (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
          </svg>
        )
      }
      {
        tool.iconName === 'calendar' && (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        )
      }
      {
        tool.iconName === 'percent' && (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 14l6-6m-5.5.5a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0zm11 5a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z" />
          </svg>
        )
      }
      {
        tool.iconName === 'clock' && (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        )
      }
      {
        tool.iconName === 'sparkles' && (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.286L13 21l-2.286-6.857L5 12l5.714-2.286L13 3z" />
          </svg>
        )
      }
    </div>

    <!-- Badges -->
    <div class="flex items-center gap-1.5 flex-wrap justify-end">
      {
        tool.badge && (
          <span class={`text-[11px] font-semibold px-2 py-0.5 rounded-full border ${badgeColors[tool.badge] || 'bg-slate-100 text-slate-700 border-slate-200'}`}>
            {tool.badge}
          </span>
        )
      }
      <span class={`text-[11px] font-medium px-2 py-0.5 rounded-full border capitalize ${categoryColors[tool.category]}`}>
        {tool.category}
      </span>
    </div>
  </div>

  <!-- Content -->
  <h3 class="text-base font-semibold text-slate-900 group-hover:text-academic-700 transition-colors flex items-center justify-between gap-2">
    <span>{tool.name}</span>
    <svg class="w-4 h-4 text-slate-400 group-hover:text-academic-600 group-hover:translate-x-0.5 transition-all flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </h3>

  <p class="mt-2 text-sm text-slate-600 line-clamp-2 leading-relaxed flex-grow">
    {tool.tagline}
  </p>

  <!-- Card bottom metadata -->
  <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
    <span class="flex items-center gap-1 text-slate-500">
      <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      {tool.estimatedTime || '< 1 min'}
    </span>
    <span class="font-medium text-academic-700 group-hover:underline">
      Use tool &rarr;
    </span>
  </div>
</a>
