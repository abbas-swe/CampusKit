---
import ToolLayout from '../../layouts/ToolLayout.astro';
import GpaCalculator from '../../components/tools/gpa/GpaCalculator.astro';
import { getToolBySlug } from '../../data/tools';
import type { FAQItem } from '../../types/seo';
import { resolvePath } from '../../utils/paths';

const tool = getToolBySlug('gpa-calculator')!;

// Targeted, student-centric FAQs addressing high-intent academic questions
const gpaFaqs: FAQItem[] = [
  {
    question: 'How do you calculate your college GPA manually?',
    answer:
      'To calculate your college GPA manually, convert each letter grade into its corresponding grade points (e.g. A = 4.0, B = 3.0), multiply each grade point value by the course credit hours to obtain Quality Points, sum all Quality Points across your courses, and divide that sum by the total number of credit hours attempted: GPA = Σ(Grade Points × Credits) ÷ Σ(Credits).',
  },
  {
    question: 'What is the difference between semester GPA and cumulative GPA (CGPA)?',
    answer:
      'Semester GPA reflects your academic standing for a single term (such as Fall or Spring semester). Cumulative GPA (CGPA) aggregates all credit hours and quality points earned across every completed semester throughout your entire university degree.',
  },
  {
    question: 'Do Pass/Fail or audit courses affect college GPA?',
    answer:
      'In most university systems across the US, Canada, and the UK, courses taken on a Pass/Fail (P/F), Satisfactory/Unsatisfactory (S/U), or audit basis do not award grade points and are excluded from the GPA calculation. However, they may satisfy degree credit requirements.',
  },
  {
    question: 'What is considered a good GPA in university?',
    answer:
      'A 3.00 GPA (B average) is generally considered solid academic standing. A 3.50 or higher frequently earns honors or Dean’s List recognition, and a 3.70+ is typically competitive for selective graduate programs, medical school, and law school admissions.',
  },
  {
    question: 'Can I calculate a custom or weighted GPA with this tool?',
    answer:
      'Yes. CampusKit supports 4.0, 5.0, and 10.0 scale standards as well as a flexible Custom Scale mode where you can define your institution’s maximum GPA ceiling and enter course grade points directly.',
  },
];
---

<ToolLayout
  tool={tool}
  pageTitle="GPA Calculator – Calculate Your Grade Point Average"
  faqs={gpaFaqs}
  canonical="/tools/gpa-calculator"
  metaDescription="Calculate your college GPA instantly with CampusKit. Free university GPA calculator supporting 4.0, 5.0, 10.0, and custom scales with letter grades and credit hours."
>
  <!-- Interactive Calculator Container -->
  <GpaCalculator />

  <!-- Comprehensive Educational SEO Guide Section (Pure Semantic HTML, fully readable without JS) -->
  <div slot="guide" class="space-y-12">
    <!-- What is GPA? -->
    <div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">
        What is GPA (Grade Point Average)?
      </h2>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        A <strong>Grade Point Average (GPA)</strong> is the universally recognized numerical summary of your academic achievement in higher education. Rather than evaluating courses on raw percentages or test scores alone, universities convert letter grades into standardized numerical grade points.
      </p>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Because different courses carry different academic workloads, college GPA is <strong>credit-weighted</strong>. A 4-credit laboratory science course has double the influence on your final GPA compared to a 2-credit elective seminar. This weighting ensures that your overall average accurately reflects your academic dedication across substantial coursework.
      </p>
    </div>

    <!-- How to Calculate GPA Formula -->
    <div class="p-6 sm:p-8 rounded-2xl bg-slate-50 border border-slate-200">
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900">
        How to Calculate GPA
      </h2>
      <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
        Calculating your grade point average involves three straightforward steps:
      </p>

      <ol class="mt-4 space-y-2.5 text-sm sm:text-base text-slate-700 list-decimal list-inside leading-relaxed">
        <li><strong>Convert each letter grade to grade points</strong> according to your university’s official scale (e.g., A = 4.0, B = 3.0).</li>
        <li><strong>Calculate Quality Points for each course</strong> by multiplying the grade points by the course’s credit hours.</li>
        <li><strong>Divide total Quality Points by total Credits</strong> attempted during the term.</li>
      </ol>

      <div class="mt-6 p-5 rounded-xl bg-white border border-slate-200 shadow-subtle text-center">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block mb-1">The Weighted GPA Formula</span>
        <div class="text-xl sm:text-2xl font-extrabold text-academic-900 font-mono tracking-tight">
          GPA = &Sigma; (Grade Points &times; Credits) &divide; &Sigma; (Credits)
        </div>
      </div>
    </div>

    <!-- Worked Example -->
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">
        Step-by-Step Worked GPA Example
      </h2>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Consider a university student enrolled in four courses during a 14-credit semester on the standard 4.0 scale:
      </p>

      <div class="mt-6 overflow-x-auto rounded-xl border border-slate-200 shadow-subtle">
        <table class="w-full text-left text-sm border-collapse bg-white">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50 text-xs font-bold uppercase tracking-wider text-slate-600">
              <th class="py-3 px-4">Course</th>
              <th class="py-3 px-4">Credits</th>
              <th class="py-3 px-4">Letter Grade</th>
              <th class="py-3 px-4">Grade Points</th>
              <th class="py-3 px-4 text-right">Quality Points</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-700">
            <tr>
              <td class="py-3 px-4 font-semibold text-slate-900">Introduction to Psychology</td>
              <td class="py-3 px-4">3</td>
              <td class="py-3 px-4"><span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 font-semibold text-xs">A</span></td>
              <td class="py-3 px-4 font-mono">4.0</td>
              <td class="py-3 px-4 font-mono text-right">3 &times; 4.0 = <strong>12.0</strong></td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold text-slate-900">General Chemistry I & Lab</td>
              <td class="py-3 px-4">4</td>
              <td class="py-3 px-4"><span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 font-semibold text-xs">B+</span></td>
              <td class="py-3 px-4 font-mono">3.3</td>
              <td class="py-3 px-4 font-mono text-right">4 &times; 3.3 = <strong>13.2</strong></td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold text-slate-900">Calculus I</td>
              <td class="py-3 px-4">4</td>
              <td class="py-3 px-4"><span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 font-semibold text-xs">A-</span></td>
              <td class="py-3 px-4 font-mono">3.7</td>
              <td class="py-3 px-4 font-mono text-right">4 &times; 3.7 = <strong>14.8</strong></td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold text-slate-900">College Composition</td>
              <td class="py-3 px-4">3</td>
              <td class="py-3 px-4"><span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 font-semibold text-xs">B</span></td>
              <td class="py-3 px-4 font-mono">3.0</td>
              <td class="py-3 px-4 font-mono text-right">3 &times; 3.0 = <strong>9.0</strong></td>
            </tr>
          </tbody>
          <tfoot>
            <tr class="border-t-2 border-slate-300 bg-slate-50/80 font-bold text-slate-900">
              <td class="py-3 px-4">Total Semester Workload</td>
              <td class="py-3 px-4 font-mono">14 Credits</td>
              <td class="py-3 px-4" colspan="2">Total Quality Points</td>
              <td class="py-3 px-4 font-mono text-right">49.0 Quality Points</td>
            </tr>
          </tfoot>
        </table>
      </div>

      <div class="mt-4 p-4 rounded-xl bg-academic-50/60 border border-academic-200 text-sm text-academic-900">
        <strong>Calculation:</strong> GPA = 49.0 &divide; 14 = <strong>3.50</strong>. This places the student within Dean’s List / Honors eligibility for the academic term.
      </div>
    </div>

    <!-- How to Use This GPA Calculator -->
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">
        How to Use This GPA Calculator
      </h2>
      <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="p-5 rounded-xl bg-white border border-slate-200 shadow-subtle">
          <span class="w-7 h-7 rounded-full bg-academic-100 text-academic-800 flex items-center justify-center font-bold text-xs mb-3">1</span>
          <h3 class="text-base font-bold text-slate-900">Select Your Grading Scale</h3>
          <p class="mt-1 text-sm text-slate-600 leading-relaxed">
            Choose between standard 4.0, weighted 5.0, international 10.0, or Custom Scale based on your university’s grading policy.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-white border border-slate-200 shadow-subtle">
          <span class="w-7 h-7 rounded-full bg-academic-100 text-academic-800 flex items-center justify-center font-bold text-xs mb-3">2</span>
          <h3 class="text-base font-bold text-slate-900">Enter Course Details</h3>
          <p class="mt-1 text-sm text-slate-600 leading-relaxed">
            Optionally input course titles, specify credit hours, and select your letter grade or direct grade points from the dropdown.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-white border border-slate-200 shadow-subtle">
          <span class="w-7 h-7 rounded-full bg-academic-100 text-academic-800 flex items-center justify-center font-bold text-xs mb-3">3</span>
          <h3 class="text-base font-bold text-slate-900">Add or Remove Rows</h3>
          <p class="mt-1 text-sm text-slate-600 leading-relaxed">
            Click <strong>Add Course</strong> to calculate additional subjects, or use the trash icon to remove dropped or audited classes.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-white border border-slate-200 shadow-subtle">
          <span class="w-7 h-7 rounded-full bg-academic-100 text-academic-800 flex items-center justify-center font-bold text-xs mb-3">4</span>
          <h3 class="text-base font-bold text-slate-900">View Instant Results</h3>
          <p class="mt-1 text-sm text-slate-600 leading-relaxed">
            Watch your term GPA, total credits, quality points, and estimated academic standing update immediately with zero lag.
          </p>
        </div>
      </div>
    </div>

    <!-- Understanding University GPA Scales -->
    <div>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">
        Understanding University GPA Scales
      </h2>
      <p class="mt-3 text-base text-slate-600 leading-relaxed">
        Grading policies differ significantly across higher education institutions worldwide. While the 4.0 scale is predominant throughout the United States and Canada, other systems are widely used:
      </p>

      <div class="mt-6 space-y-4">
        <div class="p-5 rounded-xl bg-white border border-slate-200 shadow-subtle">
          <h3 class="text-base font-bold text-slate-900">The Standard 4.0 Scale (US & Canada)</h3>
          <p class="mt-1 text-sm text-slate-600 leading-relaxed">
            Grades typically span from A+ / A (4.0) down to F (0.0). Plus and minus modifiers shift point values by 0.3 points (e.g. A- = 3.7, B+ = 3.3). This is an unweighted scale where 4.00 represents perfection.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-white border border-slate-200 shadow-subtle">
          <h3 class="text-base font-bold text-slate-900">The 5.0 Scale (Honors / Weighted Programs)</h3>
          <p class="mt-1 text-sm text-slate-600 leading-relaxed">
            Certain universities and honors curricula incorporate an extra point tier for advanced, graduate-level, or accelerated coursework, elevating the highest attainable grade to 5.0.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-white border border-slate-200 shadow-subtle">
          <h3 class="text-base font-bold text-slate-900">The 10.0 Scale (International & Engineering Systems)</h3>
          <p class="mt-1 text-sm text-slate-600 leading-relaxed">
            Utilized throughout Europe, India (AICTE/UGC), and international engineering colleges. Grades are segmented into 10-point bands (e.g., Outstanding O = 10, A+ = 9, A = 8) aligning closely with percentage percentiles.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-white border border-slate-200 shadow-subtle">
          <h3 class="text-base font-bold text-slate-900">Custom Scales & Institutional Autonomy</h3>
          <p class="mt-1 text-sm text-slate-600 leading-relaxed">
            Because individual institutions maintain independent academic governance, no online converter can claim universal authority. Always consult your university registrar or syllabus handbook to verify your degree’s exact point multipliers.
          </p>
        </div>
      </div>
    </div>

    <!-- Related Academic Workflows & Next Steps -->
    <div class="p-6 rounded-xl bg-slate-50 border border-slate-200">
      <h3 class="text-lg font-bold text-slate-900 mb-2">Next Steps for Academic Planning</h3>
      <p class="text-sm text-slate-600 mb-4 leading-relaxed">
        Calculating your term GPA is just one step in tracking your degree progress. Check out these companion calculators:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm">
        <a href={resolvePath('/tools/cgpa-calculator')} class="p-3.5 bg-white rounded-lg border border-slate-200 hover:border-academic-300 hover:text-academic-700 transition-all font-medium flex items-center justify-between group">
          <span>Calculate Cumulative CGPA</span>
          <span class="text-academic-600 group-hover:translate-x-0.5 transition-transform">&rarr;</span>
        </a>
        <a href={resolvePath('/tools/marks-needed-calculator')} class="p-3.5 bg-white rounded-lg border border-slate-200 hover:border-academic-300 hover:text-academic-700 transition-all font-medium flex items-center justify-between group">
          <span>Find Marks Needed on Finals</span>
          <span class="text-academic-600 group-hover:translate-x-0.5 transition-transform">&rarr;</span>
        </a>
        <a href={resolvePath('/tools/study-hours-calculator')} class="p-3.5 bg-white rounded-lg border border-slate-200 hover:border-academic-300 hover:text-academic-700 transition-all font-medium flex items-center justify-between group">
          <span>Plan Daily Study Hours</span>
          <span class="text-academic-600 group-hover:translate-x-0.5 transition-transform">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</ToolLayout>
