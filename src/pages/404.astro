---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import Button from '../components/common/Button.astro';
import { resolvePath } from '../utils/paths';

const popularTools = [
  {
    name: 'GPA Calculator',
    description: 'Calculate semester and cumulative grade point averages instantly.',
    href: resolvePath('/tools/gpa-calculator'),
    badge: 'Popular',
  },
  {
    name: 'CGPA Calculator',
    description: 'Compute multi-semester cumulative grade point averages.',
    href: resolvePath('/tools/cgpa-calculator'),
    badge: 'Popular',
  },
  {
    name: 'Marks Needed Calculator',
    description: 'Find the score needed on an upcoming exam to reach your target grade.',
    href: resolvePath('/tools/marks-needed-calculator'),
    badge: 'Popular',
  },
  {
    name: 'Study Hours Calculator',
    description: 'Calculate daily study hours and balance time across all subjects.',
    href: resolvePath('/tools/study-hours-calculator'),
    badge: 'Popular',
  },
  {
    name: 'Exam Countdown Timer',
    description: 'Live countdown of days, hours, and minutes until your next test.',
    href: resolvePath('/tools/exam-countdown'),
    badge: 'Timer',
  },
  {
    name: 'Pomodoro Study Timer',
    description: '25/5 and 50/10 focus intervals designed for distraction-free revision.',
    href: resolvePath('/tools/pomodoro-study-timer'),
    badge: 'Timer',
  },
];
---

<BaseLayout
  title="404 – Page Not Found"
  description="The requested page could not be found on CampusKit. Explore our free academic calculators, GPA tools, and study timers."
  noindex={true}
>
  <div class="py-16 sm:py-24 bg-slate-50 min-h-[75vh] flex items-center">
    <Container size="lg">
      <div class="max-w-3xl mx-auto text-center">
        <!-- 404 Visual Indicator -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-academic-100 text-academic-800 border border-academic-200 mb-6">
          <span>Error 404</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight">
          Page Not Found
        </h1>

        <p class="mt-4 text-base sm:text-lg text-slate-600 max-w-xl mx-auto leading-relaxed">
          The page or calculator you're looking for doesn't exist, may have moved, or is no longer available.
        </p>

        <!-- Navigation Call to Actions -->
        <div class="mt-8 flex items-center justify-center gap-4 flex-wrap">
          <Button href="/" variant="primary" size="md">
            Return to Homepage
          </Button>
          <Button href="/#tools" variant="outline" size="md">
            Browse All Tools
          </Button>
        </div>

        <!-- Quick Links to Popular Calculators -->
        <div class="mt-14 pt-10 border-t border-slate-200 text-left">
          <h2 class="text-sm font-bold uppercase tracking-wider text-slate-500 mb-5 text-center sm:text-left">
            Explore Active CampusKit Calculators
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            {
              popularTools.map((tool) => (
                <a
                  href={tool.href}
                  class="group p-4 bg-white rounded-xl border border-slate-200 hover:border-academic-300 hover:shadow-card transition-all flex flex-col justify-between"
                >
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-1.5">
                      <h3 class="font-bold text-sm text-slate-900 group-hover:text-academic-700 transition-colors">
                        {tool.name}
                      </h3>
                      <span class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-200">
                        {tool.badge}
                      </span>
                    </div>
                    <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                      {tool.description}
                    </p>
                  </div>
                  <span class="mt-3 text-xs font-semibold text-academic-700 flex items-center gap-1 group-hover:underline">
                    <span>Open tool</span>
                    <span>&rarr;</span>
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </Container>
  </div>
</BaseLayout>
