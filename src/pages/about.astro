---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/common/Container.astro';
import Button from '../components/common/Button.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import { resolvePath } from '../utils/paths';

const breadcrumbs = [{ name: 'About CampusKit', item: resolvePath('/about') }];

const academicTools = [
  {
    name: 'GPA Calculator',
    href: resolvePath('/tools/gpa-calculator'),
    description: 'Calculate semester and cumulative grade point averages across 4.0, 5.0, 10.0, and custom scales with credit weighting.',
  },
  {
    name: 'CGPA Calculator',
    href: resolvePath('/tools/cgpa-calculator'),
    description: 'Aggregate cumulative grade point averages across multiple semesters or course groups with real-time academic standing indicators.',
  },
  {
    name: 'Marks Needed Calculator',
    href: resolvePath('/tools/marks-needed-calculator'),
    description: 'Reverse-engineer the exact score needed on upcoming assignments, midterms, or projects to hit your target class average.',
  },
];

const productivityTools = [
  {
    name: 'Study Hours Calculator',
    href: resolvePath('/tools/study-hours-calculator'),
    description: 'Plan daily study time, calculate total preparation hours, and balance study workloads across multiple challenging courses.',
  },
  {
    name: 'Exam Countdown Timer',
    href: resolvePath('/tools/exam-countdown'),
    description: 'Keep important deadlines top of mind with live, second-by-second countdowns to midterms, finals, and project due dates.',
  },
  {
    name: 'Pomodoro Study Timer',
    href: resolvePath('/tools/pomodoro-study-timer'),
    description: 'Structure productive study blocks and resting intervals using proven time-boxing techniques tailored for academic focus.',
  },
];
---

<BaseLayout
  title="About CampusKit | Free Student Tools"
  description="CampusKit provides fast, free, accessible academic calculators and productivity utilities for university students worldwide with zero account friction."
  canonical="/about"
  breadcrumbs={breadcrumbs}
  activeNavPath="/about"
>
  <!-- Hero Section -->
  <div class="bg-white border-b border-slate-200">
    <Container size="lg" class="py-12 sm:py-16">
      <Breadcrumbs items={breadcrumbs} />
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-academic-50 text-academic-700 border border-academic-200/80 mt-4 mb-4">
        <span>About CampusKit</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900 leading-tight">
        Free, reliable academic tools built for everyday student life.
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed max-w-3xl">
        CampusKit is a focused collection of academic calculators and study utilities engineered to help university and college students plan coursework, track academic progress, and manage study schedules without account walls, paywalls, or privacy friction.
      </p>
    </Container>
  </div>

  <!-- Main Content Sections -->
  <div class="py-12 sm:py-16 bg-slate-50">
    <Container size="lg" class="space-y-16">
      <!-- Section 1: The Mission & Everyday Student Tasks -->
      <section class="bg-white p-8 sm:p-10 rounded-2xl border border-slate-200 shadow-subtle">
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight">
          Our Mission: Practical Utility Without Friction
        </h2>
        <div class="mt-4 text-slate-600 space-y-4 leading-relaxed text-sm sm:text-base">
          <p>
            University life involves constant academic calculations: estimating grade targets on syllabus day, figuring out what score is needed on a final exam, verifying GPA for honors or scholarship criteria, and tracking attendance limits before midterm review.
          </p>
          <p>
            Too often, students encounter clunky spreadsheets, tools hidden behind mandatory account registrations, invasive tracking, or paywalled interfaces. CampusKit exists to provide a clean, dependable alternative: high-speed, well-calibrated tools that perform standard academic calculations instantly and transparently.
          </p>
        </div>
      </section>

      <!-- Section 2: Who CampusKit Is Designed For -->
      <section class="bg-white p-8 sm:p-10 rounded-2xl border border-slate-200 shadow-subtle">
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight">
          Who These Tools Are Designed For
        </h2>
        <p class="mt-3 text-slate-600 text-sm sm:text-base leading-relaxed">
          CampusKit is built for anyone navigating structured academic coursework in higher education:
        </p>

        <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-5 rounded-xl bg-slate-50 border border-slate-200/80">
            <div class="w-8 h-8 rounded-lg bg-academic-100 text-academic-700 flex items-center justify-center font-bold text-sm mb-3">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              </svg>
            </div>
            <h3 class="text-base font-bold text-slate-900">Undergraduate Students</h3>
            <p class="mt-1.5 text-xs sm:text-sm text-slate-600 leading-relaxed">
              Navigating semester GPA calculations, credit hours, weighted syllabi, and prerequisite thresholds.
            </p>
          </div>

          <div class="p-5 rounded-xl bg-slate-50 border border-slate-200/80">
            <div class="w-8 h-8 rounded-lg bg-academic-100 text-academic-700 flex items-center justify-center font-bold text-sm mb-3">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <h3 class="text-base font-bold text-slate-900">Graduate Scholars</h3>
            <p class="mt-1.5 text-xs sm:text-sm text-slate-600 leading-relaxed">
              Managing multi-year cumulative grade point averages, research study sessions, and rigorous academic standing standards.
            </p>
          </div>

          <div class="p-5 rounded-xl bg-slate-50 border border-slate-200/80">
            <div class="w-8 h-8 rounded-lg bg-academic-100 text-academic-700 flex items-center justify-center font-bold text-sm mb-3">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-base font-bold text-slate-900">College Enrollees Worldwide</h3>
            <p class="mt-1.5 text-xs sm:text-sm text-slate-600 leading-relaxed">
              Studying under standard North American 4.0, 5.0, 10.0, or percentage-based international university grading structures.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Core Pillars (Simplicity, Accessibility, Transparency, Privacy) -->
      <section>
        <div class="text-center max-w-2xl mx-auto mb-10">
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
            Our Core Pillars
          </h2>
          <p class="mt-2 text-slate-600 text-sm sm:text-base">
            CampusKit is designed around four foundational principles that put students first.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-6 sm:p-8 bg-white rounded-2xl border border-slate-200 shadow-subtle flex flex-col">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-xl bg-academic-100 text-academic-700 flex items-center justify-center font-bold">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900">Simplicity & Speed</h3>
            </div>
            <p class="text-sm text-slate-600 leading-relaxed flex-grow">
              Every tool loads instantaneously with minimal interface clutter. You never need to register an account, remember another password, or verify an email address to calculate your grades or start a focus timer.
            </p>
          </div>

          <div class="p-6 sm:p-8 bg-white rounded-2xl border border-slate-200 shadow-subtle flex flex-col">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-xl bg-academic-100 text-academic-700 flex items-center justify-center font-bold">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900">Privacy by Design</h3>
            </div>
            <p class="text-sm text-slate-600 leading-relaxed flex-grow">
              All grade calculations and course entries run strictly client-side inside your browser’s JavaScript engine. Your course names, scores, and academic metrics are never sent to or stored on remote servers.
            </p>
          </div>

          <div class="p-6 sm:p-8 bg-white rounded-2xl border border-slate-200 shadow-subtle flex flex-col">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-xl bg-academic-100 text-academic-700 flex items-center justify-center font-bold">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900">Mathematical Transparency</h3>
            </div>
            <p class="text-sm text-slate-600 leading-relaxed flex-grow">
              Each tool documents the underlying mathematical formulas, credit weightings, and rounding steps. Students can verify exactly how results are determined rather than trusting an opaque black box.
            </p>
          </div>

          <div class="p-6 sm:p-8 bg-white rounded-2xl border border-slate-200 shadow-subtle flex flex-col">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 rounded-xl bg-academic-100 text-academic-700 flex items-center justify-center font-bold">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900">Inclusive Accessibility</h3>
            </div>
            <p class="text-sm text-slate-600 leading-relaxed flex-grow">
              Engineered with accessible contrast ratios, semantic HTML landmarks, full keyboard navigability, clear ARIA labeling, and responsive touch controls on mobile devices.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Current Categories & Available Tools -->
      <section class="space-y-8">
        <div>
          <h2 class="text-2xl font-bold text-slate-900 tracking-tight">
            Current Tools & Categories
          </h2>
          <p class="mt-2 text-slate-600 text-sm sm:text-base">
            CampusKit currently offers utilities across two core categories: Academic Calculators and Study Productivity.
          </p>
        </div>

        <!-- Academic Calculators Category -->
        <div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-subtle">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-9 h-9 rounded-lg bg-academic-700 text-white flex items-center justify-center font-bold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-bold text-slate-900">Academic Calculators</h3>
              <p class="text-xs text-slate-500">Formulas for GPA, course grades, exam targets, and attendance policies.</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {
              academicTools.map((tool) => (
                <a
                  href={tool.href}
                  class="p-4 rounded-xl border border-slate-200/80 hover:border-academic-400 hover:bg-academic-50/40 transition-colors group flex flex-col justify-between"
                >
                  <div>
                    <h4 class="text-sm font-bold text-slate-900 group-hover:text-academic-700 transition-colors flex items-center justify-between">
                      {tool.name}
                      <span class="text-academic-600 opacity-0 group-hover:opacity-100 transition-opacity text-xs font-semibold">
                        Open &rarr;
                      </span>
                    </h4>
                    <p class="mt-1.5 text-xs text-slate-600 leading-relaxed">
                      {tool.description}
                    </p>
                  </div>
                </a>
              ))
            }
          </div>
        </div>

        <!-- Study Productivity Category -->
        <div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-subtle">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-9 h-9 rounded-lg bg-indigo-700 text-white flex items-center justify-center font-bold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-bold text-slate-900">Study Productivity</h3>
              <p class="text-xs text-slate-500">Practical utilities for study scheduling, time management, and deadlines.</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {
              productivityTools.map((tool) => (
                <a
                  href={tool.href}
                  class="p-4 rounded-xl border border-slate-200/80 hover:border-indigo-400 hover:bg-indigo-50/40 transition-colors group flex flex-col justify-between"
                >
                  <div>
                    <h4 class="text-sm font-bold text-slate-900 group-hover:text-indigo-700 transition-colors flex items-center justify-between">
                      {tool.name}
                      <span class="text-indigo-600 opacity-0 group-hover:opacity-100 transition-opacity text-xs font-semibold">
                        Open &rarr;
                      </span>
                    </h4>
                    <p class="mt-1.5 text-xs text-slate-600 leading-relaxed">
                      {tool.description}
                    </p>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Section 5: Academic Disclaimer Note -->
      <section class="p-6 rounded-2xl bg-academic-50 border border-academic-200/80">
        <div class="flex gap-3.5">
          <div class="flex-shrink-0 text-academic-700">
            <svg class="w-5 h-5 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-bold text-academic-900">Informational & Planning Guidance</h3>
            <p class="mt-1 text-xs sm:text-sm text-academic-800 leading-relaxed">
              CampusKit calculators are designed as informational aids to support student planning and self-assessment. Because grading schemes, plus/minus weights, and attendance policies vary between institutions, departments, and course syllabi, students should always verify official academic standings and graduation requirements with their institution's registrar or instructor.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 6: Action CTA -->
      <div class="bg-academic-900 text-white rounded-2xl p-8 sm:p-10 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-elevated">
        <div>
          <h3 class="text-xl sm:text-2xl font-bold tracking-tight">Ready to calculate your grades?</h3>
          <p class="text-academic-200 text-sm mt-1 max-w-xl">
            Open the GPA Calculator or explore the full directory of free academic tools.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <Button href="/tools/gpa-calculator" variant="primary" size="lg" class="bg-white text-academic-900 hover:bg-academic-50 border-white">
            GPA Calculator
          </Button>
          <Button href="/#tools" variant="secondary" size="lg" class="bg-academic-800 text-white hover:bg-academic-700 border-academic-700">
            View All Tools
          </Button>
        </div>
      </div>
    </Container>
  </div>
</BaseLayout>
